{
  "manifest_version": 3,
  "name": "Clip — YouTube, Instagram, TikTok Downloader",
  "short_name": "Clip",
  "version": "1.1.0",
  "description": "One-click video downloads. Adds a Download button to YouTube, Instagram, TikTok, Twitter and Facebook.",
  "author": "Clip",
  "action": {
    "default_title": "Clip — Download this video",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "activeTab", "tabs", "downloads"],
  "host_permissions": [
    "https://*.youtube.com/*",
    "https://*.youtu.be/*",
    "https://*.instagram.com/*",
    "https://*.tiktok.com/*",
    "https://*.twitter.com/*",
    "https://*.x.com/*",
    "https://*.facebook.com/*",
    "http://localhost:3000/*",
    "https://YOUR-DOMAIN.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.youtube.com/*",
        "https://*.youtu.be/*",
        "https://*.instagram.com/*",
        "https://*.tiktok.com/*",
        "https://*.twitter.com/*",
        "https://*.x.com/*",
        "https://*.facebook.com/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
