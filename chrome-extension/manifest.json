{
  "manifest_version": 3,
  "name": "Clip — One-Click Video Downloader",
  "short_name": "Clip",
  "version": "1.1.1",
  "description": "Adds a Download button to popular video sites. Save in MP4 or MP3 with one click. No watermark, no signup.",
  "author": "Clip",
  "action": {
    "default_title": "Clip — Download this video",
    "default_popup": "popup.html"
  },
  "permissions": ["storage", "activeTab", "tabs", "downloads"],
  "host_permissions": [
    "https://*.youtube.com/*",
    "https://*.youtu.be/*",
    "https://*.instagram.com/*",
    "https://*.tiktok.com/*",
    "https://*.twitter.com/*",
    "https://*.x.com/*",
    "https://*.facebook.com/*",
    "http://localhost:3000/*",
    "https://clipexports.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.youtube.com/*",
        "https://*.youtu.be/*",
        "https://*.instagram.com/*",
        "https://*.tiktok.com/*",
        "https://*.twitter.com/*",
        "https://*.x.com/*",
        "https://*.facebook.com/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
